# Backend API base URL (no trailing slash). Switch to http://localhost:8080/api when running
# the Spring backend locally; otherwise leave on production.
NEXT_PUBLIC_API_BASE=https://fittel-backend.onrender.com/api

# Firebase Web App config — register a Web App at:
# https://console.firebase.google.com/project/fitboi-9e2d8/settings/general
# (iOS/Android apps are already registered; web needs its own entry with its own apiKey + appId)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCCLLxobI1Qt2q7VbWNyUgbFz6JOT2OnfE
NEXT_PUBLIC_FIREBASE_APP_ID=1:446856946395:web:f00a64c85d2cfad31122fe
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fitboi-9e2d8.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fitboi-9e2d8
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fitboi-9e2d8.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=446856946395

# Private admin activity console. The bcrypt password hash is verified by the
# Spring backend. ADMIN_API_TOKEN must match the backend's ADMIN_API_TOKEN.
BACKEND_INTERNAL_ORIGIN=https://fittel-backend.onrender.com
ADMIN_API_TOKEN=replace-with-a-long-random-server-token
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Configure this on the backend service, not in NEXT_PUBLIC_*:
# ADMIN_DASHBOARD_PASSWORD_HASH=$2a$12$...
# ANALYTICS_EXCLUDED_EMAILS=trainerview@fittel.info,clientview@fittel.info
